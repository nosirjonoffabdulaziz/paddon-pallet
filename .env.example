# ================================================================
#  PADDON / PALLET — muhit o‘zgaruvchilari (environment variables)
#  Bu faylni nusxalab ".env" nomi bilan saqlang va qiymatlarni kiriting.
#  .env fayli GIT'ga yuklanmaydi (maxfiy).
# ================================================================

# --- Ma’lumotlar bazasi (PostgreSQL) -----------------------------
# Neon / Vercel Postgres / Supabase yoki o‘zingizning serveringiz.
# Neon'da "pooled" ulanishni DATABASE_URL ga, "direct" ulanishni DIRECT_URL ga qo‘ying.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# --- Sayt manzili (SEO, sitemap uchun) ---------------------------
NEXT_PUBLIC_SITE_URL="https://example.uz"

# --- Admin panel --------------------------------------------------
# Sessiya imzosi uchun uzun tasodifiy satr (kamida 32 belgi).
# Yaratish: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET="replace-with-a-long-random-string-at-least-32-characters"

# Birinchi admin foydalanuvchi (faqat "npm run db:seed" paytida yaratiladi).
# Keyin parolni admin paneldagi "Sozlamalar" bo‘limidan almashtiring.
ADMIN_EMAIL="admin@example.uz"
ADMIN_PASSWORD="change-me-strong-password"

# --- Rasm yuklash (Vercel Blob) ----------------------------------
# Vercel → Storage → Blob yaratilganda avtomatik qo‘shiladi.
# Lokal kompyuterda bo‘sh qoldirsangiz, rasmlar ./uploads papkasiga saqlanadi.
BLOB_READ_WRITE_TOKEN=""

# --- Telegram xabarnomalar (ixtiyoriy) ---------------------------
# @BotFather orqali bot yarating → token. Botga /start yozing,
# so‘ng chat ID ni oling (README'dagi ko‘rsatmaga qarang).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
